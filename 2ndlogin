import java.io.*;
import java.util.*;
import org.apache.poi.ss.usermodel.*;
import org.apache.poi.xssf.usermodel.*;

public class LoginPatient {

    private static final String FILE_NAME = "Patients.xlsx";

    public static void loginPatient() {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter your phone number: ");
        String inputPhone = sc.nextLine().trim();

        System.out.print("Enter your password: ");
        String inputPassword = sc.nextLine().trim();

        try (FileInputStream fis = new FileInputStream(FILE_NAME);
             Workbook workbook = new XSSFWorkbook(fis)) {

            Sheet sheet = workbook.getSheetAt(0);
            boolean found = false;

            for (Row row : sheet) {
                if (row.getRowNum() == 0) continue; // Skip header

                Cell phoneCell = row.getCell(4);
                Cell passwordCell = row.getCell(5);

                String phone = phoneCell.toString().trim();
                String password = passwordCell.toString().trim();

                if (phone.equals(inputPhone) && password.equals(inputPassword)) {
                    String id = row.getCell(0).toString();
                    String name = row.getCell(1).toString();
                    System.out.println("✅ Login successful! Welcome, " + name + " (ID: " + id + ")");
                    found = true;
                    break;
                }
            }

            if (!found) {
                System.out.println("❌ Invalid phone or password. Please try again.");
            }

        } catch (FileNotFoundException e) {
            System.out.println("❌ Patients.xlsx file not found.");
        } catch (IOException e) {
            System.out.println("❌ Error reading Patients.xlsx: " + e.getMessage());
        }
    }
}
