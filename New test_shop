import pytest
from selenium.webdriver.common.by import By
from selenium.webdriver.common.keys import Keys

def test_add_item_to_cart(browser, base_url, registered_user):
    driver = browser
    driver.get(base_url)

    # Login
    driver.find_element(By.LINK_TEXT, "Log in").click()
    driver.find_element(By.ID, "Email").send_keys(registered_user["email"])
    driver.find_element(By.ID, "Password").send_keys(registered_user["password"])
    driver.find_element(By.CSS_SELECTOR, "input.button-1.login-button").click()

    # Go to Books category
    driver.find_element(By.LINK_TEXT, "Books").click()

    # Add the first item to the cart
    driver.find_element(By.CSS_SELECTOR, "input[value='Add to cart']").click()

    # Click on the shopping cart
    driver.find_element(By.LINK_TEXT, "Shopping cart").click()

    # Verify item is in the cart
    cart_items = driver.find_elements(By.CSS_SELECTOR, ".cart-item-row")
    assert len(cart_items) > 0, "Cart should have at least one item"

    print("Item added to cart successfully")

def test_checkout_process(browser, base_url, registered_user):
    driver = browser
    driver.get(base_url)

    # Login
    driver.find_element(By.LINK_TEXT, "Log in").click()
    driver.find_element(By.ID, "Email").send_keys(registered_user["email"])
    driver.find_element(By.ID, "Password").send_keys(registered_user["password"])
    driver.find_element(By.CSS_SELECTOR, "input.button-1.login-button").click()

    # Go to Shopping cart
    driver.find_element(By.LINK_TEXT, "Shopping cart").click()

    # Agree to terms
    driver.find_element(By.ID, "termsofservice").click()

    # Proceed to checkout
    driver.find_element(By.ID, "checkout").click()

    # Just a basic check to see if it went to checkout page
    assert "checkout" in driver.current_url.lower(), "Should be redirected to checkout page"

    print("Checkout process initiated")

